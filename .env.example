# ==============================================================================
# Sparky Desktop Companion - Gemma AI Configuration
# ==============================================================================

# Intelligence Engine Backend:
# Options:
#   'local' : In-process Gemma 3 270M running on CPU via Candle in Rust (ultra-low resource, no API key needed)
#   'api'   : Remote Gemma 4 / Gemini API (requires GEMMA_API_KEY)
# Defaults to 'local' when no GEMMA_API_KEY is found, or 'api' when key is provided.
GEMMA_ENGINE=local

# Model identifier:
# For local engine: gemma-3-270m
# For API engine:   gemma-4, gemini-2.5-flash
GEMMA_MODEL=gemma-3-270m

# Local Model Path for Gemma 3 270M (directory containing config.json, tokenizer.json, model.safetensors)
# Defaults to ./models/gemma-3-270m or ~/.cache/sparky/gemma-3-270m
# GEMMA_MODEL_PATH=./models/gemma-3-270m

# Optional: Hugging Face Token (if you wish to auto-download Gemma 3 270M weights via hf-hub)
# HF_TOKEN=

# API Engine Settings (only required when GEMMA_ENGINE=api):
# Your Google Gemini / Gemma API key from Google AI Studio (https://aistudio.google.com/)
GEMMA_API_KEY=

# Optional: API base URL. Defaults to Google AI Studio:
# https://generativelanguage.googleapis.com
# For OpenAI-compatible servers (vLLM, OpenRouter, etc.):
# GEMMA_API_BASE=http://localhost:8000/v1

# Sparky Personality Archetype:
# Options: chaos_gremlin, hype_pet, zen_monk, tsundere, or custom:<description>
SPARKY_PERSONALITY=chaos_gremlin

# Interval in seconds between periodic Gemma intelligence checks (default: 20)
SPARKY_BRAIN_INTERVAL_SECS=20

# Optional: Disable AI engine entirely and use pure random playback (true/false)
SPARKY_DISABLE_BRAIN=false
